@model DigiShop.Models.Category
@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="row">
    <div class="col-md-12">
        <h2>Xóa danh mục</h2>
        <hr />
        <div class="alert alert-danger">
            <h4>Bạn có chắc chắn muốn xóa danh mục này?</h4>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="dl-horizontal">
            <dt>Tên danh mục</dt>
            <dd>@Model.Name</dd>
            
            <dt>Mô tả</dt>
            <dd>@Model.Description</dd>
        </dl>
        
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <span class="glyphicon glyphicon-trash"></span> Xóa
            </button>
            <a asp-action="Index" class="btn btn-default">
                <span class="glyphicon glyphicon-chevron-left"></span> Quay lại
            </a>
        </form>
    </div>
</div>
