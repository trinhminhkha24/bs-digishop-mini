@model IEnumerable<DigiShop.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="row">
    <div class="col-md-12">
        <h2>Quản lý sản phẩm</h2>
        <hr />
        <p>
            <a asp-action="Create" class="btn btn-success">
                <span class="glyphicon glyphicon-plus"></span> Thêm sản phẩm mới
            </a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Giá</th>
                    <th>Giá KM</th>
                    <th>Mới</th>
                    <th>KM</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Category?.Name</td>
                        <td>@(item.Price?.ToString("N0")) đ</td>
                        <td>@(item.SalePrice?.ToString("N0")) đ</td>
                        <td>@(item.IsNewProduct ? "✓" : "")</td>
                        <td>@(item.IsOnSale ? "✓" : "")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                <span class="glyphicon glyphicon-edit"></span> Sửa
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                <span class="glyphicon glyphicon-info-sign"></span> Chi tiết
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                <span class="glyphicon glyphicon-trash"></span> Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <a asp-controller="Categories" asp-action="Index" class="btn btn-default">
            Quản lý danh mục
        </a>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-default">
            Về trang chủ
        </a>
    </div>
</div>
