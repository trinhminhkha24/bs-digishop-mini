@using Microsoft.AspNetCore.Identity
@using DigiShop.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <li class="dropdown">
        <a href="#" class="dropdown-toggle" data-toggle="dropdown">@User.Identity?.Name <b class="caret"></b></a>
        <ul class="dropdown-menu">
            <li>
                <form asp-area="Identity" asp-page="/Account/Manage/Index" method="get">
                    <button type="submit" class="btn btn-link" style="text-decoration: none; color: inherit; padding: 3px 20px; display: block; width: 100%; text-align: left;">
                        Tài khoản
                    </button>
                </form>
            </li>
            <li class="divider"></li>
            <li>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-link" style="text-decoration: none; color: inherit; padding: 3px 20px; display: block; width: 100%; text-align: left;">
                        Đăng xuất
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li><a asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a></li>
    <li><a asp-area="Identity" asp-page="/Account/Register">Đăng ký</a></li>
}
