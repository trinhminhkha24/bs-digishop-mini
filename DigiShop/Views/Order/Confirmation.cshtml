@{
    ViewData["Title"] = "Xác nhận đơn hàng";
}

<div class="row">
    <div class="col-md-12">
        <div class="alert alert-success">
            <h2><span class="glyphicon glyphicon-ok-circle"></span> Đặt hàng thành công!</h2>
            <hr />
            <p>Cảm ơn bạn đã đặt hàng. Mã đơn hàng của bạn là: <strong>#@ViewBag.OrderId</strong></p>
            <p>Chúng tôi sẽ liên hệ với bạn sớm nhất để xác nhận đơn hàng.</p>
            <hr />
            <p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <span class="glyphicon glyphicon-home"></span> Về trang chủ
                </a>
            </p>
        </div>
    </div>
</div>
