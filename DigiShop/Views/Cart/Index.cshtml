@model List<DigiShop.ViewModels.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="row">
    <div class="col-md-12">
        <h2>Giỏ hàng của bạn</h2>
        <hr />
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Tổng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/assets/img/dummyimg.png" : item.ImageUrl)" 
                                     alt="@item.ProductName" style="max-width: 80px;" />
                            </td>
                            <td>@item.ProductName</td>
                            <td>@(item.Price?.ToString("N0")) đ</td>
                            <td>
                                <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" style="display:inline;">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" 
                                           style="width: 70px;" class="form-control" />
                                    <button type="submit" class="btn btn-sm btn-primary">Cập nhật</button>
                                </form>
                            </td>
                            <td><strong>@(item.Total?.ToString("N0")) đ</strong></td>
                            <td>
                                <form asp-controller="Cart" asp-action="RemoveFromCart" method="post" style="display:inline;">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <span class="glyphicon glyphicon-trash"></span> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    <tr>
                        <td colspan="4" class="text-right"><strong>Tổng cộng:</strong></td>
                        <td colspan="2"><strong class="text-danger">@(Model.Sum(x => x.Total)?.ToString("N0")) đ</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="pull-right">
                <a asp-controller="Home" asp-action="Index" class="btn btn-default">
                    <span class="glyphicon glyphicon-chevron-left"></span> Tiếp tục mua hàng
                </a>
                <form asp-controller="Order" asp-action="Create" method="post" style="display:inline;">
                    <button type="submit" class="btn btn-success btn-lg">
                        <span class="glyphicon glyphicon-ok"></span> Đặt hàng
                    </button>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info">
                <h4>Giỏ hàng của bạn đang trống!</h4>
                <p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        Về trang chủ
                    </a>
                </p>
            </div>
        </div>
    </div>
}
