@model DigiShop.Models.Category
@{
    ViewData["Title"] = Model.Name;
}

<div class="row">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="active">@Model.Name</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h2>@Model.Name</h2>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p>@Model.Description</p>
        }
        <hr />
    </div>
</div>

<div class="row">
    @if (Model.Products != null && Model.Products.Any())
    {
        @foreach (var product in Model.Products)
        {
            <div class="col-md-4 text-center col-sm-6 col-xs-6">
                <div class="thumbnail product-box">
                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/assets/img/dummyimg.png" : product.ImageUrl)" alt="@product.Name" />
                    <div class="caption">
                        <h3><a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h3>
                        @if (product.IsOnSale && product.SalePrice.HasValue)
                        {
                            <p>
                                Giá gốc: <strong style="text-decoration: line-through;">@(product.Price?.ToString("N0")) đ</strong><br />
                                Giá KM: <strong class="text-danger">@(product.SalePrice.Value.ToString("N0")) đ</strong>
                            </p>
                        }
                        else
                        {
                            <p>Giá: <strong>@(product.Price?.ToString("N0")) đ</strong></p>
                        }
                        <p>@(product.Description != null && product.Description.Length > 50 ? product.Description.Substring(0, 50) : product.Description ?? "")</p>
                        <p>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post" style="display:inline;">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-success">Thêm vào giỏ</button>
                            </form>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-primary">Xem chi tiết</a>
                        </p>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-md-12">
            <div class="alert alert-info">
                Chưa có sản phẩm nào trong danh mục này.
            </div>
        </div>
    }
</div>
